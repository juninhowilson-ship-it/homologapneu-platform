DATABASE_URL="postgresql://user:password@host:5432/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# Recuperação de senha por e-mail (opcional). Sem RESEND_API_KEY, o fluxo
# "esqueci minha senha" registra uma solicitação para o administrador na tela
# de Usuários em vez de enviar e-mail.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="HomologaPneu <nao-responda@seudominio.com.br>"
# Base dos links de redefinição enviados por e-mail (ex.: https://app.exemplo.com)
# NEXT_PUBLIC_APP_URL=""

# Catálogo comercial: conexão do banco do Intelli Tire (ERP irmão), usada
# pelo `npm run sync:comercial` para saber quais pneus existem e ainda giram.
# INTELLI_TIRE_DATABASE_URL="postgresql://..."

# Fotos de veículo: conexão do banco do Radar Automotivo SP (projeto irmão),
# usada pelo `npm run sync:fotos`. As imagens são do Wikimedia Commons sob
# CC BY / CC BY-SA e vêm com o crédito exigido pela licença.
# RADAR_DATABASE_URL="postgresql://..."
